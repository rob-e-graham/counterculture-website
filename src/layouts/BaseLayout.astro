---
import "../styles/global.css";
import StickyPlayer from "../components/StickyPlayer.astro";
import { siteSettings } from "../data/site";

type Props = {
  title?: string;
  description?: string;
};

const { title = siteSettings.title, description = siteSettings.description } =
  Astro.props;
const pageTitle =
  title === siteSettings.title ? title : `${title} | ${siteSettings.title}`;
const canonicalUrl = `https://${siteSettings.domain}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#92ff00" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="camoWarp">
        <feTurbulence type="fractalNoise" baseFrequency="0.011 0.017" numOctaves="4" seed="7" result="t" />
        <feDisplacementMap in="SourceGraphic" in2="t" scale="78" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <div class="camo" aria-hidden="true">
      <span class="camo-slice camo-slice-a"></span>
      <span class="camo-slice camo-slice-b"></span>
    </div>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Counterculture home">
        <span>Counter</span><strong>Culture</strong>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/roster">Roster</a>
        <a href="/episodes">Episodes</a>
        <a href="/djs">Residents</a>
        <a href="/about">About</a>
        <a href={`mailto:${siteSettings.contactEmail}`}>Contact</a>
        <a href="/shop">Shop</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{siteSettings.domain} · {siteSettings.station}</p>
      <div>
        <a href={siteSettings.facebookUrl}>Facebook</a>
        <a href={siteSettings.listenLiveUrl}>Listen live</a>
        <a href={`mailto:${siteSettings.contactEmail}`}>Email</a>
        <a href={siteSettings.shopUrl}>Shop</a>
      </div>
    </footer>
    <StickyPlayer />
  </body>
</html>
