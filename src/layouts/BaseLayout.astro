---
import "../styles/global.css";
import StickyPlayer from "../components/StickyPlayer.astro";
import DialMark from "../components/DialMark.astro";
import { siteSettings } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const {
  title = siteSettings.title,
  description = siteSettings.description,
  noindex = false
} = Astro.props;
const pageTitle =
  title === siteSettings.title ? title : `${title} | ${siteSettings.title}`;
// Per-page canonical. This previously pointed every page at the homepage.
const site = Astro.site ?? new URL(`https://${siteSettings.domain}`);
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/assets/og-share.png", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#92ff00" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteSettings.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Counterculture — Kiss FM Australia, Saturdays 12:00-1:30PM" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="camoWarp">
        <feTurbulence type="fractalNoise" baseFrequency="0.011 0.017" numOctaves="4" seed="7" result="t" />
        <feDisplacementMap in="SourceGraphic" in2="t" scale="78" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <div class="camo" aria-hidden="true">
      <span class="camo-slice camo-slice-a"></span>
      <span class="camo-slice camo-slice-b"></span>
    </div>
    <div class="mesh" aria-hidden="true">
      <span class="mesh-blob mesh-1"></span>
      <span class="mesh-blob mesh-2"></span>
      <span class="mesh-blob mesh-3"></span>
      <span class="mesh-blob mesh-4"></span>
    </div>
    <div class="halftone" aria-hidden="true"></div>
    <div class="glitch" aria-hidden="true">
      <span class="glitch-band glitch-band-1"></span>
      <span class="glitch-band glitch-band-2"></span>
      <span class="glitch-band glitch-band-3"></span>
    </div>
    {/* Real VHS tape noise over the page. Decoding a fullscreen video costs
        power, so it is desktop-only and drops out under reduced-motion. */}
    <video
      class="vhs"
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
    >
      <source src="/assets/tex/vhs.webm" type="video/webm" />
      <source src="/assets/tex/vhs.mp4" type="video/mp4" />
    </video>
    <div class="noise" aria-hidden="true"></div>
    <div class="paper" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Counterculture home">
        <DialMark class="brand-mark" loading="eager" alt="" />
        <span class="brand-word"><span>Counter</span><strong>Culture</strong></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/roster">Roster</a>
        <a href="/episodes">Episodes</a>
        <a href="/djs">Residents</a>
        <a href="/about">About</a>
        <a href={`mailto:${siteSettings.contactEmail}`}>Contact</a>
        <a href="/shop">Shop</a>
      </nav>
    </header>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span>Rewind come again tell ya friend</span><span>Jungle massive</span><span>Kiss FM 87.8</span><span>Saturdays 12 til 1:30</span><span>Melbourne</span><span>Dnb · Hardcore · Rave · UKG</span>
        <span>Rewind come again tell ya friend</span><span>Jungle massive</span><span>Kiss FM 87.8</span><span>Saturdays 12 til 1:30</span><span>Melbourne</span><span>Dnb · Hardcore · Rave · UKG</span>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-brand">
        <DialMark class="footer-mark" alt="" />
        <span>{siteSettings.domain} · {siteSettings.station}</span>
      </p>
      <div>
        <a href={siteSettings.facebookUrl}>Facebook</a>
        <a href={siteSettings.listenLiveUrl}>Listen live</a>
        <a href={`mailto:${siteSettings.contactEmail}`}>Email</a>
        <a href={siteSettings.shopUrl}>Shop</a>
      </div>
    </footer>
    <StickyPlayer />
    <script is:inline>
      // GitHub's Contents API uses the current blob SHA for optimistic locking.
      // Some browsers/CDNs can reuse a cached GET here, which makes the crew
      // publisher send an old SHA and GitHub correctly replies with 409.
      // Force GitHub contents reads fresh, and if a PUT still races another
      // commit, refresh its SHA and retry the write once.
      (() => {
        const nativeFetch = window.fetch.bind(window);
        const isGithubContents = (url) =>
          /^https:\/\/api\.github\.com\/repos\/rob-e-graham\/counterculture-website\/contents\//.test(url);

        window.fetch = async (input, init = {}) => {
          const rawUrl = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
          const method = String(init.method || (input instanceof Request ? input.method : "GET")).toUpperCase();

          if (!isGithubContents(rawUrl)) return nativeFetch(input, init);

          if (method === "GET") {
            const freshUrl = new URL(rawUrl);
            freshUrl.searchParams.set("_ccfresh", String(Date.now()));
            return nativeFetch(freshUrl.href, { ...init, cache: "no-store" });
          }

          const first = await nativeFetch(input, init);
          if (method !== "PUT" || first.status !== 409 || !init.body) return first;

          try {
            const body = JSON.parse(String(init.body));
            const freshUrl = new URL(rawUrl);
            freshUrl.searchParams.set("ref", body.branch || "main");
            freshUrl.searchParams.set("_ccfresh", String(Date.now()));
            const current = await nativeFetch(freshUrl.href, {
              headers: init.headers,
              cache: "no-store"
            });
            if (!current.ok) return first;
            const currentFile = await current.json();
            if (!currentFile.sha) return first;
            body.sha = currentFile.sha;
            return nativeFetch(input, { ...init, body: JSON.stringify(body) });
          } catch (_) {
            return first;
          }
        };
      })();
    </script>
  </body>
</html>
