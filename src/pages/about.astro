---
import BaseLayout from "../layouts/BaseLayout.astro";
import { crew, siteSettings } from "../data/site";
---

<BaseLayout title="About">
  <section class="page-title">
    <div>
      <p class="kicker">Melbourne underground bass radio</p>
      <h1>About <span>Counterculture</span></h1>
    </div>
  </section>
  <section class="section two-col">
    <article class="system-panel">
      <h2>The Show</h2>
      <p>
        Counterculture is a weekly underground bass music broadcast on KISS FM
        Australia, currently running Saturdays from 12:00PM to 1:30PM.
      </p>
      <p>
        The crew is now being solidified around a bigger Melbourne-based team,
        with inductions, deeds, roster planning, and a shared availability sheet
        keeping the operation tight.
      </p>
      <p>
        The aim is to build toward a two-hour 12-2pm slot, giving the show more
        room for guests, two-DJ sessions, MC combinations, and a stronger link
        between Kiss FM, Counterculture, and the Howler fundraiser events.
      </p>
      <div class="link-row">
        <a class="button primary" href={siteSettings.listenLiveUrl}>Listen live</a>
        <a class="button" href={`mailto:${siteSettings.contactEmail}`}>Email the crew</a>
      </div>
    </article>
    <article class="system-panel">
      <h2>Crew</h2>
      <ul>
        {crew.map((name) => <li>{name}</li>)}
      </ul>
    </article>
  </section>

  <section class="section feature-band">
    <div>
      <p class="eyebrow">Home base</p>
      <h2>{siteSettings.domain}</h2>
    </div>
    <p>
      This site is the public hub for the show: roster, resident profiles,
      episode archive, merch, event updates, and future fundraiser activity.
    </p>
  </section>
</BaseLayout>
