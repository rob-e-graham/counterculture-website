---
import BaseLayout from "../layouts/BaseLayout.astro";
import { crew, siteSettings } from "../data/site";
---

<BaseLayout title="About">
  <section class="page-title">
    <div>
      <p class="kicker">Melbourne jungle radio</p>
      <h1>About <span>Counterculture</span></h1>
    </div>
  </section>
  <section class="section two-col">
    <article class="system-panel">
      <h2>The Show</h2>
      <p>
        Counterculture is a weekly jungle and drum and bass show on Kiss FM
        Australia. Saturdays 12:00PM to 1:30PM.
      </p>
      <p>
        This site keeps the live stream, replays, residents, merch, and event
        links in one place.
      </p>
      <div class="link-row">
        <a class="button primary" href={siteSettings.listenLiveUrl}>Listen live</a>
        <a class="button" href={`mailto:${siteSettings.contactEmail}`}>Email the crew</a>
      </div>
    </article>
    <article class="system-panel">
      <h2>Residents</h2>
      <ul>
        {crew.map((name) => <li>{name}</li>)}
      </ul>
    </article>
  </section>

  <section class="section feature-band">
    <div>
      <p class="eyebrow">Home base</p>
      <h2>{siteSettings.domain}</h2>
    </div>
    <p>
      A simple home for the show, replays, residents, merch, and events.
    </p>
  </section>
</BaseLayout>
