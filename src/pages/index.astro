---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShowCard from "../components/ShowCard.astro";
import DjCard from "../components/DjCard.astro";
import { roster } from "../data/roster";
import { djs } from "../data/djs";
import { siteSettings } from "../data/site";

const nextShows = roster.slice(0, 3);
const featuredCrew = djs.slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="kicker">counterculture.vip · {siteSettings.station}</p>
      <h1>Counter<span>Culture</span></h1>
      <p>
        Melbourne jungle, drum and bass, sound system pressure, and Saturday
        radio energy. The crew is expanding, the roster is getting sharper, and
        the next chapter is built for bigger sessions on air and in the dance.
      </p>
      <div class="button-row">
        <a class="button primary" href={siteSettings.listenLiveUrl}>Listen live</a>
        <a class="button" href="/roster">View roster</a>
        <a class="button" href={`mailto:${siteSettings.contactEmail}`}>Contact</a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src="/assets/spring-session-2026.png"
        alt="Counterculture Spring Session 2026 flyer at Howler Garden Bar"
        width="1500"
        height="2100"
      />
    </div>
  </section>

  <section class="signal-strip" aria-label="Show summary">
    <p>Live Saturdays</p>
    <p>{siteSettings.schedule}</p>
    <p>{siteSettings.proposedSchedule} proposed</p>
    <p>Jungle · Drum and bass · Melbourne</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Next Shows</h2>
      <a class="text-link" href="/roster">Full roster</a>
    </div>
    <div class="grid">
      {nextShows.map((show) => <ShowCard show={show} />)}
    </div>
  </section>

  <section class="section feature-band">
    <div>
      <p class="eyebrow">Howler events</p>
      <h2>Spring Session 2026</h2>
    </div>
    <div>
      <p>
        Saturday 19 September 2026 at Howler Garden Bar, Brunswick. Midday til
        late, free party, free tickets via yougig.com, with Benny Page in the
        main room and the Counterculture crew pushing jungle, bass, dub, rave,
        drum and bass, and breaks.
      </p>
      <div class="link-row">
        <a class="button primary" href={`mailto:${siteSettings.contactEmail}`}>Event contact</a>
        <a class="button" href="https://yougig.events/event/e6384b8b-3dbb-4b52-9e80-98bfdf751d09?action=created">Free tickets</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Resident Crew</h2>
      <a class="text-link" href="/djs">All DJs</a>
    </div>
    <div class="grid">
      {featuredCrew.map((dj) => <DjCard dj={dj} />)}
    </div>
  </section>
</BaseLayout>
