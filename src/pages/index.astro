---
import BaseLayout from "../layouts/BaseLayout.astro";
import DjCard from "../components/DjCard.astro";
import MixcloudPlayer from "../components/MixcloudPlayer.astro";
import { djs } from "../data/djs";
import { episodes } from "../data/episodes";
import { roster } from "../data/roster";
import { siteSettings } from "../data/site";

const latestEpisode = episodes[0];

// Next show = the soonest roster slot that has not passed yet.
const now = new Date();
const upcoming = [...roster]
  .filter((r) => new Date(`${r.date}T23:59:59+10:00`) >= now)
  .sort((a, b) => a.date.localeCompare(b.date));
const nextShow = upcoming[0] ?? roster[0];
const nextShowDate = new Date(`${nextShow.date}T12:00:00+10:00`).toLocaleDateString(
  "en-AU",
  { weekday: "long", day: "numeric", month: "long" }
);
const statusClass = nextShow.status.toLowerCase().replace(/\s+/g, "-");
const nextGuest =
  nextShow.guest && nextShow.guest !== "TBA" ? nextShow.guest : "";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <a class="station-badge" href={siteSettings.kissFmUrl} aria-label={siteSettings.station}>
        <img src="/assets/kiss-fm-pirate.svg" alt="KISS FM Australia" width="150" height="103" />
        <span>Broadcast on {siteSettings.station}</span>
      </a>
      <div class="hero-next">
        <div class="hero-next-head">
          <span class="eyebrow">Next show</span>
          {/* "Confirmed" is internal roster state — only surface a badge when
              it tells the public something, like an open guest slot. */}
          {nextShow.status !== "Confirmed" && (
            <span class={`status status-${statusClass}`}>{nextShow.status}</span>
          )}
        </div>
        <p class="next-date">{nextShowDate} · {nextShow.time}</p>
        <h1 class="hero-dj">{nextShow.dj}</h1>
        <p class="next-meta">
          {nextShow.mc}{nextGuest ? ` · Guest: ${nextGuest}` : ""}
        </p>
      </div>
      <div class="button-row">
        <a class="button primary" href={siteSettings.listenLiveUrl}>● Listen live</a>
        <button
          class="button"
          type="button"
          data-cc-play={latestEpisode.mixcloudKey}
          data-cc-title={latestEpisode.title}
        >
          ▶ Play latest show
        </button>
        <a class="button" href="/roster">Full roster</a>
      </div>
    </div>

    <div class="hero-media">
      <img
        src="/assets/spring-session-2026.png"
        alt="Counterculture Spring Session 2026 flyer at Howler Garden Bar"
        loading="eager"
      />
    </div>
  </section>

  <section class="signal-strip" aria-label="Show summary">
    <p>{siteSettings.schedule}</p>
    <p>Jungle</p>
    <p>Hardcore</p>
    <p>DNB</p>
    <p>Rave</p>
    <p>Bass &amp; UKG</p>
  </section>

  <section class="section latest-band">
    <div class="section-head">
      <div>
        <p class="eyebrow">Latest replay</p>
        <h2>{latestEpisode.title}</h2>
      </div>
      <a class="text-link" href="/episodes">Full archive →</a>
    </div>
    <MixcloudPlayer mixcloudKey={latestEpisode.mixcloudKey} title={latestEpisode.title} />
  </section>

  <section class="section feature-band">
    <div>
      <p class="eyebrow">Howler events</p>
      <h2>Spring Session 2026</h2>
    </div>
    <div>
      <p>
        Saturday 19 September 2026 at Howler Garden Bar, Brunswick. Midday til
        late. Free entry. Benny Page is in the main room, with Counterculture
        residents playing jungle, dub, rave, drum and bass, breaks, and
        whatever else fits.
      </p>
      <div class="link-row">
        <a class="button primary" href="https://yougig.events/event/e6384b8b-3dbb-4b52-9e80-98bfdf751d09?action=created">Free tickets</a>
        <a class="button" href={`mailto:${siteSettings.contactEmail}`}>Event contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Residents</h2>
      <a class="text-link" href="/djs">All residents</a>
    </div>
    <div class="grid dj-grid">
      {djs.map((dj) => <DjCard dj={dj} />)}
    </div>
  </section>
</BaseLayout>
