---
import BaseLayout from "../layouts/BaseLayout.astro";
import { djs } from "../data/djs";
import { episodes } from "../data/episodes";
import { upcomingSlots } from "../data/roster";
import { siteSettings } from "../data/site";
---

<BaseLayout title="Crew Tools" noindex={true}>
  <section class="page-title tools-title">
    <div>
      <p class="kicker">Hidden crew page</p>
      <h1>Roster <span>Tools</span></h1>
    </div>
    <p>
      Plan the Saturday slot, keep guest details in one place, and make a flyer
      from the same show info.
    </p>
  </section>

  <section class="section tools-shell">
    <article class="system-panel tools-board">
      <div class="section-head">
        <div>
          <p class="eyebrow">Roster</p>
          <h2>Upcoming Shows</h2>
        </div>
        <div class="button-row">
          <button class="button primary" type="button" id="copy-sheet-row">Copy row for sheet</button>
          <button class="button" type="button" id="publish-site">Publish file</button>
          <button class="button" type="button" id="new-slot">New slot</button>
          <button class="button" type="button" id="export-csv">CSV</button>
          <button class="button" type="button" id="export-calendar">Calendar</button>
        </div>
      </div>
      <div id="roster-board" class="roster-board" aria-live="polite"></div>
      <p id="publish-status" class="publish-status" role="status"></p>
    </article>

    <div class="tool-grid">
      <article class="system-panel tool-panel">
        <p class="eyebrow">Show details</p>
        <h2>Build Slot</h2>
        <form id="show-form" class="stacked-form">
          <input name="id" type="hidden" />
          <label>
            Show title
            <input name="title" value="Counterculture Radio" required />
          </label>
          <div class="form-pair">
            <label>
              Date
              <input name="date" type="date" required />
            </label>
            <label>
              Time
              <input name="time" value="12:00-1:30PM" required />
            </label>
          </div>
          <div class="form-pair">
            <label>
              On the controls
              <input name="residents" list="resident-list" placeholder="Anyone on the crew, MCs included" required />
            </label>
            <label>
              MC on the mic (optional)
              <input name="mcs" list="resident-list" placeholder="Leave blank if none" />
            </label>
          </div>
          <label>
            Guests
            <input name="guests" placeholder="Guest DJ, MC, label, crew" />
          </label>
          <div class="form-pair">
            <label>
              Status
              <select name="status">
                <option>Confirmed</option>
                <option>Open guest</option>
                <option>Needs induction</option>
                <option>Draft</option>
              </select>
            </label>
            <label>
              Platform / venue
              <input name="venue" value="KISS FM Australia" required />
            </label>
          </div>
          <div class="form-pair">
            <label>
              Repeats
              <select name="repeat">
                <option value="once">Just this date</option>
                <option value="weekly">Every week</option>
                <option value="fortnightly">Every 2 weeks</option>
                <option value="monthly">Every 4 weeks</option>
                <option value="bimonthly">Every 8 weeks</option>
              </select>
            </label>
            <label>
              How many times
              <input name="repeatCount" type="number" min="1" max="26" value="6" />
            </label>
          </div>
          <label>
            Ticket / event link
            <input name="ticketUrl" value="https://yougig.events/event/e6384b8b-3dbb-4b52-9e80-98bfdf751d09?action=created" />
          </label>
          <label>
            Plain show copy
            <textarea name="notes" rows="5">Jungle, Hardcore, DNB, UKG &amp; Bass music from Melbourne. Live on Kiss FM Australia. Stream on the Kiss FM app or kissfm.com.au. Listen back to the archive and get show updates at counterculture.vip</textarea>
          </label>
          <div class="form-pair">
            <label>
              Flyer image
              <input id="flyer-image" name="flyerImage" type="file" accept="image/*" />
            </label>
            <label>
              Image placement
              <select name="imageMode">
                <option value="panel">Centre panel</option>
                <option value="background">Full background</option>
              </select>
            </label>
          </div>
          <datalist id="resident-list">
            {djs.map((dj) => <option value={dj.name} />)}
          </datalist>
          <div class="button-row">
            <button class="button primary" type="submit">Save slot</button>
            <button class="button" type="button" id="download-flyer">Download flyer</button>
            <button class="button" type="button" id="copy-blurb">Copy blurb</button>
            <button class="button" type="button" id="email-show">Email slot</button>
          </div>
        </form>
      </article>

      <article class="flyer-preview-panel">
        <canvas id="flyer-canvas" width="1080" height="1350" aria-label="Generated show flyer preview"></canvas>
      </article>
    </div>
  </section>

  <section class="section tool-grid">
    <article class="system-panel tool-panel">
      <p class="eyebrow">Resident info</p>
      <h2>Bio Form</h2>
      <form id="bio-form" class="stacked-form">
        <div class="form-pair">
          <label>
            Artist
            <select name="artist" id="bio-artist" required>
              <option value="">Choose your name…</option>
              {djs.filter((d) => d.active).map((d) => <option value={d.name}>{d.name}</option>)}
              <option value="__new">Someone else…</option>
            </select>
          </label>
          <label id="bio-newname-wrap" hidden>
            New artist name
            <input name="newArtist" placeholder="Name as it should appear" />
          </label>
          <label>
            Role
            <input name="role" placeholder="DJ, MC, host, manager" required />
          </label>
        </div>
        <label>
          Short bio
          <textarea name="bio" rows="5" maxlength="420" required placeholder="Simple, honest, 2-4 sentences."></textarea>
        </label>
        <div class="form-pair">
          <label>
            Instagram
            <input name="instagram" placeholder="@name or URL" />
          </label>
          <label>
            Mixcloud / SoundCloud
            <input name="mix" placeholder="Profile URL" />
          </label>
        </div>
        <label>
          Press image
          <input id="bio-image" name="image" type="file" accept="image/*" />
        </label>
        <div class="button-row">
          <button class="button primary" type="submit">Save bio</button>
          <button class="button primary" type="button" id="publish-bios">Publish bios</button>
          <button class="button" type="button" id="export-bios">Export bios</button>
          <button class="button" type="button" id="email-bio">Email bio</button>
        </div>
      </form>
    </article>

    <article class="profile-preview system-panel">
      <p class="eyebrow">Bio preview</p>
      <img id="bio-preview-image" src="/assets/counterculture-poster.png" alt="" />
      <h2 id="bio-preview-name">Artist Name</h2>
      <p id="bio-preview-role">Role</p>
      <p id="bio-preview-copy">Short bio preview will appear here.</p>
    </article>
  </section>

  <section class="section tool-grid">
    <article class="system-panel tool-panel">
      <p class="eyebrow">Gigs and parties</p>
      <h2>Add Event</h2>
      <form id="event-form" class="stacked-form">
        <label>
          Event name
          <input name="name" placeholder="Spring Session 2026" required />
        </label>
        <div class="form-pair">
          <label>
            Date
            <input name="date" type="date" required />
          </label>
          <label>
            Time
            <input name="time" placeholder="Midday til late" />
          </label>
        </div>
        <div class="form-pair">
          <label>
            Venue
            <input name="venue" placeholder="Howler Garden Bar" required />
          </label>
          <label>
            Suburb / city
            <input name="city" placeholder="Brunswick" />
          </label>
        </div>
        <label>
          Line-up
          <input name="lineup" placeholder="Benny Page, Counterculture residents" />
        </label>
        <div class="form-pair">
          <label>
            Entry
            <input name="entry" placeholder="Free entry" />
          </label>
          <label>
            Ticket link
            <input name="ticketUrl" placeholder="https://" />
          </label>
        </div>
        <label>
          Details
          <textarea name="notes" rows="3" placeholder="What to expect, room info, anything else."></textarea>
        </label>
        <label>
          Event flyer
          <input id="event-image" name="image" type="file" accept="image/*" />
        </label>
        <div class="button-row">
          <button class="button primary" type="submit">Save event</button>
          <button class="button" type="button" id="email-event">Email event</button>
          <button class="button" type="button" id="export-events">Export events</button>
          <button class="button" type="button" id="events-calendar">Calendar</button>
        </div>
      </form>
    </article>

    <article class="system-panel">
      <p class="eyebrow">Saved events</p>
      <img id="event-preview-image" class="event-preview-image" src="/assets/spring-session-2026.png" alt="" />
      <div id="event-list" class="draft-list"></div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Saved Drafts</h2>
      <div class="button-row">
        <button class="button" type="button" id="export-json">Export shows</button>
        <button class="button" type="button" id="clear-drafts">Clear local drafts</button>
      </div>
    </div>
    <div class="drafts-grid">
      <article class="system-panel">
        <p class="eyebrow">Shows</p>
        <div id="show-drafts" class="draft-list"></div>
      </article>
      <article class="system-panel">
        <p class="eyebrow">Bios</p>
        <div id="bio-drafts" class="draft-list"></div>
      </article>
    </div>
  </section>

  <script define:vars={{ contactEmail: siteSettings.contactEmail, seedRoster: upcomingSlots(8), residentNames: djs.filter((d) => d.active).map((d) => d.name), siteDjs: djs, episodeCount: Math.floor(episodes.length / 10) * 10 }}>
    const showForm = document.querySelector("#show-form");
    const bioForm = document.querySelector("#bio-form");
    const flyerCanvas = document.querySelector("#flyer-canvas");
    const flyerImageInput = document.querySelector("#flyer-image");
    const bioImageInput = document.querySelector("#bio-image");
    const rosterBoard = document.querySelector("#roster-board");
    const ctx = flyerCanvas.getContext("2d");

    const SHOW_COPY =
      "Jungle, Hardcore, DNB, UKG & Bass music from Melbourne. Live on Kiss FM Australia. Stream on the Kiss FM app or kissfm.com.au. Listen back to the archive and get show updates at counterculture.vip";

    const rosterKey = "cc-roster-slots";
    const biosKey = "cc-bios";
    const seedSlots = seedRoster.map((item) => ({
      id: `seed-${item.date}-${item.dj}`.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
      title: "Counterculture Radio",
      date: item.date,
      time: item.time,
      residents: item.dj,
      mcs: item.mc,
      guests: item.guest === "TBA" ? "" : item.guest,
      status: item.dj ? item.status : "Draft",
      venue: "KISS FM Australia",
      ticketUrl: "",
      notes: item.notes || SHOW_COPY
    }));

    // Upcoming Saturdays worked out in the browser, not at build time, so the
    // board never shows last week once the date rolls over.
    const nextSaturdays = (count) => {
      const out = [];
      const d = new Date();
      d.setHours(12, 0, 0, 0);
      d.setDate(d.getDate() + ((6 - d.getDay() + 7) % 7));
      for (let i = 0; i < count; i++) {
        out.push(
          d.getFullYear() + "-" +
          String(d.getMonth() + 1).padStart(2, "0") + "-" +
          String(d.getDate()).padStart(2, "0")
        );
        d.setDate(d.getDate() + 7);
      }
      return out;
    };

    const state = {
      flyerImage: null,
      bioImage: null,
      counterweightLogo: null,
      kissLogo: null,
      slots: (() => {
        const saved = JSON.parse(localStorage.getItem(rosterKey) || "null") || [];
        const dates = nextSaturdays(8);
        const today = dates[0];

        // Drop anything already aired: a board full of last week's shows is
        // what made the flyer and blurb come out with the wrong date.
        const future = saved.filter((s) => s.date && s.date >= today);

        // Whatever is published on the site wins for a given date, so a booking
        // that reached the front page shows up here too.
        const published = new Map(seedSlots.filter((s) => s.residents).map((s) => [s.date, s]));

        return dates.map((date) => {
          const mine = future.find((s) => s.date === date);
          const live = published.get(date);
          if (live && (!mine || !mine.residents)) return { ...live, id: live.id || `slot-${date}` };
          if (mine) return mine;
          return {
            id: `slot-${date}`,
            title: "Counterculture Radio",
            date,
            time: "12:00-1:30PM",
            residents: "",
            mcs: "",
            guests: "",
            status: "Draft",
            venue: "KISS FM Australia",
            ticketUrl: "",
            notes: SHOW_COPY
          };
        });
      })(),
      // Dedupe on load: earlier versions appended on every save, so existing
      // storage can hold the same artist several times. Newest entry wins.
      bios: (() => {
        const raw = JSON.parse(localStorage.getItem(biosKey) || "[]");
        const seen = new Set();
        return raw.filter((b) => {
          const k = String(b.artist || "").trim().toLowerCase();
          if (!k || seen.has(k)) return false;
          seen.add(k);
          return true;
        });
      })()
    };

    const getFormData = (form) => Object.fromEntries(new FormData(form).entries());
    const slugify = (value) =>
      String(value || "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "") || "counterculture";

    const saveSlots = () => localStorage.setItem(rosterKey, JSON.stringify(state.slots));

    const downloadText = (filename, text, type = "text/plain") => {
      const blob = new Blob([text], { type });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    };

    const formatDate = (value) => {
      if (!value) return "Date TBA";
      return new Date(`${value}T12:00:00`).toLocaleDateString("en-AU", {
        weekday: "short",
        day: "2-digit",
        month: "short",
        year: "numeric"
      });
    };

    const setForm = (slot) => {
      Object.entries(slot).forEach(([key, value]) => {
        const field = showForm.elements.namedItem(key);
        if (field) field.value = value || "";
      });
      // Older saved slots have no copy — fall back rather than blanking it.
      if (!showForm.elements.namedItem("notes").value) {
        showForm.elements.namedItem("notes").value = SHOW_COPY;
      }
      drawFlyer();
    };

    const blankSlot = () => ({
      id: `slot-${Date.now()}`,
      title: "Counterculture Radio",
      date: "",
      time: "12:00-1:30PM",
      residents: "",
      mcs: "",
      guests: "",
      status: "Draft",
      venue: "KISS FM Australia",
      ticketUrl: "",
      notes: SHOW_COPY
    });

    const wrapText = (text, x, y, maxWidth, lineHeight, maxLines = 8) => {
      const words = String(text || "").trim().split(/\s+/).filter(Boolean);
      let line = "";
      let lines = 0;
      for (const word of words) {
        const test = `${line}${word} `;
        if (ctx.measureText(test).width > maxWidth && line) {
          ctx.fillText(line.trim(), x, y);
          line = `${word} `;
          y += lineHeight;
          lines += 1;
          if (lines >= maxLines) return y;
        } else {
          line = test;
        }
      }
      if (line && lines < maxLines) ctx.fillText(line.trim(), x, y);
      return y + lineHeight;
    };

    const drawImageCover = (image, x, y, width, height) => {
      const scale = Math.max(width / image.width, height / image.height);
      const sw = width / scale;
      const sh = height / scale;
      const sx = (image.width - sw) / 2;
      const sy = (image.height - sh) / 2;
      ctx.drawImage(image, sx, sy, sw, sh, x, y, width, height);
    };

    // Render the mark black-on-acid to match the site, from the supplied
    // orange artwork whose ticks are transparent knockouts.
    const markCache = {};
    const blackMark = (image, size) => {
      if (markCache[size]) return markCache[size];
      const off = document.createElement("canvas");
      off.width = size;
      off.height = size;
      const octx = off.getContext("2d");
      octx.beginPath();
      octx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
      octx.fillStyle = "#92ff00";
      octx.fill();
      const inner = document.createElement("canvas");
      inner.width = size;
      inner.height = size;
      const ictx = inner.getContext("2d");
      ictx.drawImage(image, 0, 0, size, size);
      ictx.globalCompositeOperation = "source-in";
      ictx.fillStyle = "#000000";
      ictx.fillRect(0, 0, size, size);
      octx.drawImage(inner, 0, 0);
      markCache[size] = off;
      return off;
    };

    // Shrink until it fits, so a long single word can never bleed off the edge
    // the way wrapText alone allowed.
    const fitFont = (text, maxWidth, startPx, weight = 900) => {
      let px = startPx;
      ctx.font = `${weight} ${px}px Arial`;
      while (px > 28 && ctx.measureText(text).width > maxWidth) {
        px -= 2;
        ctx.font = `${weight} ${px}px Arial`;
      }
      return px;
    };

    const drawFlyer = () => {
      const data = getFormData(showForm);
      const M = 64;
      const W = 1080;
      const CW = W - M * 2;

      ctx.fillStyle = "#08090a";
      ctx.fillRect(0, 0, 1080, 1350);

      if (state.flyerImage && data.imageMode === "background") {
        drawImageCover(state.flyerImage, 0, 0, 1080, 1350);
        ctx.fillStyle = "rgba(0, 0, 0, 0.68)";
        ctx.fillRect(0, 0, 1080, 1350);
      } else {
        for (let x = -1350; x < 1080 + 1350; x += 96) {
          ctx.fillStyle = "rgba(29, 51, 17, 0.5)";
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x + 34, 0);
          ctx.lineTo(x + 34 - 1350, 1350);
          ctx.lineTo(x - 1350, 1350);
          ctx.closePath();
          ctx.fill();
        }
      }

      const wash = ctx.createLinearGradient(0, 0, 1080, 1350);
      wash.addColorStop(0, "rgba(146, 255, 0, 0.10)");
      wash.addColorStop(0.6, "rgba(5, 5, 5, 0)");
      wash.addColorStop(1, "rgba(255, 22, 136, 0.10)");
      ctx.fillStyle = wash;
      ctx.fillRect(0, 0, 1080, 1350);

      // Masthead is wordmark only — the mark already carries the centre panel,
      // and two dials this close read as a duplicate.
      ctx.textBaseline = "alphabetic";
      ctx.fillStyle = "#f5f5f2";
      ctx.font = "900 48px Arial";
      ctx.fillText("COUNTERCULTURE", M, 116);
      ctx.fillStyle = "#92ff00";
      ctx.font = "900 20px Arial";
      ctx.fillText("KISS FM AUSTRALIA  ·  87.8FM / 87.6FM  ·  SATURDAYS", M + 2, 146);

      ctx.strokeStyle = "rgba(245,245,242,0.28)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(M, 196);
      ctx.lineTo(W - M, 196);
      ctx.stroke();

      // hero: who is on
      const acts = String(data.residents || "Residents TBA")
        .toUpperCase()
        .split(",")
        .map((v) => v.trim())
        .filter(Boolean);
      let y = 330;
      acts.slice(0, 3).forEach((act) => {
        const px = fitFont(act, CW, 150);
        ctx.font = `900 ${px}px Arial`;
        ctx.fillStyle = "#f5f5f2";
        ctx.fillText(act, M, y);
        y += px * 0.96;
      });

      const support = [data.mcs, data.guests]
        .filter(Boolean)
        .join("  +  ")
        .toUpperCase();
      if (support) {
        const px = fitFont(support, CW, 58);
        ctx.font = `900 ${px}px Arial`;
        ctx.fillStyle = "#92ff00";
        y += 24;
        ctx.fillText(support, M, y);
        y += px;
      }

      const title = String(data.title || "").trim();
      if (title && title.toLowerCase() !== "counterculture radio") {
        ctx.font = "900 32px Arial";
        ctx.fillStyle = "#b4b4aa";
        y += 20;
        ctx.fillText(title.toUpperCase(), M, y);
      }

      // Centre panel: the artwork sits in the space between the line-up and the
      // date band, which was otherwise dead.
      const panelTop = Math.max(y + 40, 400);
      const panelH = 1004 - 34 - panelTop;
      if (panelH > 120) {
        // Roll-call occupies a fixed left column; the artwork takes the rest.
        // Both are centred on the same axis so the two halves balance.
        const names = (Array.isArray(residentNames) ? residentNames : []).slice(0, 10);
        const rollW = names.length ? 300 : 0;
        const artX = M + rollW + (rollW ? 28 : 0);
        const artW = CW - rollW - (rollW ? 28 : 0);

        if (state.flyerImage && data.imageMode !== "background") {
          ctx.save();
          ctx.beginPath();
          ctx.rect(artX, panelTop, artW, panelH);
          ctx.clip();
          drawImageCover(state.flyerImage, artX, panelTop, artW, panelH);
          ctx.restore();
          ctx.strokeStyle = "rgba(245,245,242,0.22)";
          ctx.lineWidth = 2;
          ctx.strokeRect(artX, panelTop, artW, panelH);
        } else if (!state.flyerImage && state.counterweightLogo) {
          const size = Math.min(artW * 0.92, panelH * 0.9);
          ctx.drawImage(
            blackMark(state.counterweightLogo, Math.round(size)),
            artX + (artW - size) / 2,
            panelTop + (panelH - size) / 2,
            size,
            size
          );
        }
      }

      // Roll-call: aligned to the same left margin as the masthead, headline and
      // copy, and centred vertically against the artwork rather than starting
      // at the top of the panel.
      if (panelH > 200 && Array.isArray(residentNames) && residentNames.length) {
        const names = residentNames.slice(0, 10);
        const lineH = 33;
        const blockH = 26 + names.length * lineH;
        let rollY = panelTop + (panelH - blockH) / 2 + 18;

        ctx.font = "900 18px Arial";
        ctx.fillStyle = "#92ff00";
        ctx.fillText("ON ROTATION", M, rollY);
        rollY += 34;

        ctx.font = "900 27px Arial";
        ctx.fillStyle = "#f5f5f2";
        names.forEach((n) => {
          ctx.fillText(n.toUpperCase(), M, rollY);
          rollY += lineH;
        });
      }

      // date band, anchored to the lower third
      const bandY = 1004;
      ctx.fillStyle = "#92ff00";
      ctx.fillRect(M, bandY, CW, 118);
      ctx.fillStyle = "#08090a";
      const stamp = `${formatDate(data.date).toUpperCase()}   ${String(data.time || "").toUpperCase()}`;
      const stampPx = fitFont(stamp, CW - 64, 46);
      ctx.font = `900 ${stampPx}px Arial`;
      ctx.fillText(stamp, M + 32, bandY + 76);

      // Show copy: four lines of room so the full blurb fits without clipping.
      ctx.fillStyle = "#f5f5f2";
      ctx.font = "900 25px Arial";
      wrapText(data.notes || "", M, 1172, CW, 31, 4);

      // footer
      ctx.fillStyle = "#92ff00";
      ctx.font = "900 30px Arial";
      ctx.fillText("counterculture.vip", M, 1312);
      ctx.fillStyle = "#b4b4aa";
      ctx.font = "900 22px Arial";
      const right = "kissfm.com.au";
      ctx.fillText(right, W - M - ctx.measureText(right).width, 1312);
    };

    const renderRoster = () => {
      const sorted = [...state.slots].sort((a, b) => String(a.date).localeCompare(String(b.date)));
      rosterBoard.innerHTML = sorted
        .map(
          (slot) => `
            <article class="roster-row">
              <button type="button" data-edit="${slot.id}" aria-label="Edit ${slot.title} on ${slot.date || "date TBA"}">
                <strong>${formatDate(slot.date)}</strong>
                <span>${slot.time || "Time TBA"}</span>
              </button>
              <div>
                <p class="eyebrow">${slot.status || "Draft"}</p>
                <h3>${slot.residents || "Residents TBA"}</h3>
                <p>${[slot.mcs, slot.guests].filter(Boolean).join(" + ") || "No MC or guest listed"}</p>
              </div>
              <button class="button" type="button" data-flyer="${slot.id}">Flyer</button>
            </article>
          `
        )
        .join("");
    };

    const refreshDrafts = () => {
      document.querySelector("#show-drafts").innerHTML = state.slots.length
        ? state.slots
            .map((item) => `<p><strong>${formatDate(item.date)}</strong><br>${item.residents || "Residents TBA"} · ${item.status || "Draft"}</p>`)
            .join("")
        : "<p>No show drafts saved yet.</p>";
      document.querySelector("#bio-drafts").innerHTML = state.bios.length
        ? state.bios.map((item) => `<p><strong>${item.artist}</strong><br>${item.role || "Role TBA"}</p>`).join("")
        : "<p>No bio drafts saved yet.</p>";
    };

    const refreshBioPreview = () => {
      const data = getFormData(bioForm);
      document.querySelector("#bio-preview-name").textContent = data.artist || "Artist Name";
      document.querySelector("#bio-preview-role").textContent = data.role || "Role";
      document.querySelector("#bio-preview-copy").textContent = data.bio || "Short bio preview will appear here.";
    };

    const slotToCsv = (slot) =>
      ["date", "time", "title", "residents", "mcs", "guests", "status", "venue", "ticketUrl", "notes"]
        .map((key) => `"${String(slot[key] || "").replaceAll('"', '""')}"`)
        .join(",");

    const exportCalendar = () => {
      const events = state.slots
        .filter((slot) => slot.date)
        .map((slot) => {
          const date = slot.date.replaceAll("-", "");
          const summary = `${slot.title || "Counterculture Radio"} - ${slot.residents || "Residents TBA"}`;
          const description = [slot.mcs, slot.guests, slot.notes, slot.ticketUrl].filter(Boolean).join("\\n");
          return [
            "BEGIN:VEVENT",
            `UID:${slot.id}@counterculture.vip`,
            `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "")}`,
            `DTSTART;VALUE=DATE:${date}`,
            `SUMMARY:${summary}`,
            `DESCRIPTION:${description.replace(/\n/g, "\\n")}`,
            "END:VEVENT"
          ].join("\r\n");
        })
        .join("\r\n");
      downloadText(
        "counterculture-roster.ics",
        `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Counterculture//Roster//EN\r\n${events}\r\nEND:VCALENDAR`,
        "text/calendar"
      );
    };

    showForm.addEventListener("input", drawFlyer);
    bioForm.addEventListener("input", refreshBioPreview);

    // toBlob rather than toDataURL: the flyer is over a megabyte, and Safari
    // silently refuses downloads from data: URLs that size. A blob URL is also
    // far cheaper than base64-ing the whole canvas into a string.
    const downloadFlyer = () => {
      drawFlyer();
      const data = getFormData(showForm);
      const name = `counterculture-${slugify(data.residents || data.title)}-${data.date || "date-tba"}.png`;
      flyerCanvas.toBlob((blob) => {
        if (!blob) {
          publishStatus.textContent = "The flyer could not be generated. Try again once the artwork has loaded.";
          return;
        }
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = name;
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      }, "image/png");
    };

    rosterBoard.addEventListener("click", (event) => {
      const target = event.target.closest("button");
      if (!target) return;
      const id = target.dataset.edit || target.dataset.flyer;
      const slot = state.slots.find((item) => item.id === id);
      if (!slot) return;
      setForm(slot);
      // Loading the row into the form and then making the user find a second
      // button was a trap: "Flyer" now produces the flyer for that row.
      if (target.dataset.flyer) {
        setTimeout(downloadFlyer, 250);
        publishStatus.textContent = `Flyer downloaded for ${slot.residents || "this slot"} on ${formatDate(slot.date)}.`;
      }
    });

    document.querySelector("#new-slot").addEventListener("click", () => setForm(blankSlot()));

    flyerImageInput.addEventListener("change", () => {
      const file = flyerImageInput.files?.[0];
      if (!file) return;
      const image = new Image();
      image.onload = () => {
        state.flyerImage = image;
        drawFlyer();
      };
      image.src = URL.createObjectURL(file);
    });

    bioImageInput.addEventListener("change", () => {
      const file = bioImageInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const preview = document.querySelector("#bio-preview-image");
        preview.src = String(reader.result);
        state.bioImage = String(reader.result);
      };
      reader.readAsDataURL(file);
    });

    // Repeat intervals in weeks. The show is weekly, so everything is a
    // multiple of 7 days rather than a calendar month, which would drift off
    // Saturday.
    const REPEAT_WEEKS = { once: 0, weekly: 1, fortnightly: 2, monthly: 4, bimonthly: 8 };

    const addWeeks = (iso, weeks) => {
      const d = new Date(`${iso}T12:00:00Z`);
      d.setUTCDate(d.getUTCDate() + weeks * 7);
      return d.toISOString().slice(0, 10);
    };

    showForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const form = getFormData(showForm);
      const every = REPEAT_WEEKS[form.repeat] || 0;
      const times = every ? Math.max(1, Math.min(26, Number(form.repeatCount) || 1)) : 1;

      let added = 0;
      for (let i = 0; i < times; i++) {
        const date = i === 0 ? form.date : addWeeks(form.date, every * i);
        if (!date) break;
        const data = {
          ...form,
          date,
          // Only the first slot keeps the edited id, so a repeat never
          // overwrites the slot being edited.
          id: i === 0
            ? (showForm.elements.namedItem("id").value || `slot-${Date.now()}`)
            : `slot-${Date.now()}-${i}`
        };
        delete data.repeat;
        delete data.repeatCount;

        // One booking per date: a repeat replaces whatever sat on that date.
        const sameDate = state.slots.findIndex((slot) => slot.date === date);
        const byId = state.slots.findIndex((slot) => slot.id === data.id);
        if (byId >= 0) state.slots[byId] = data;
        else if (sameDate >= 0) state.slots[sameDate] = data;
        else state.slots.push(data);
        added++;
      }

      state.slots.sort((a, b) => String(a.date).localeCompare(String(b.date)));
      saveSlots();
      renderRoster();
      refreshDrafts();
      drawFlyer();
      publishStatus.textContent =
        added > 1
          ? `Saved ${added} dates. Hit "Publish file" when the roster looks right.`
          : `Saved. Hit "Publish file" when the roster looks right.`;
    });

    bioForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const raw = getFormData(bioForm);
      const artist = raw.artist === "__new" ? String(raw.newArtist || "").trim() : raw.artist;
      if (!artist) return;
      const data = { ...raw, artist, image: state.bioImage, savedAt: new Date().toISOString() };
      delete data.newArtist;
      // One bio per artist: saving again replaces rather than stacking.
      state.bios = state.bios.filter(
        (b) => String(b.artist || "").toLowerCase() !== artist.toLowerCase()
      );
      state.bios.unshift(data);
      localStorage.setItem(biosKey, JSON.stringify(state.bios));
    saveSlots();
      refreshDrafts();
    });

    // Social blurb built from the same slot as the flyer, so the post and the
    // artwork can never disagree about who is on or when.
    const buildBlurb = () => {
      const d = getFormData(showForm);
      const when = d.date
        ? new Date(`${d.date}T12:00:00`).toLocaleDateString("en-AU", {
            weekday: "short", day: "numeric", month: "short"
          }).toUpperCase()
        : "TBA";
      const acts = String(d.residents || "").trim().toUpperCase() || "LINE-UP TBA";
      const support = [d.mcs, d.guests].map((v) => String(v || "").trim()).filter(Boolean);
      const rotation = (Array.isArray(residentNames) ? residentNames : [])
        .map((n) => n.toUpperCase())
        .join(" · ");
      const time = String(d.time || "12:00-1:30PM");

      return [
        `⚡ COUNTERCULTURE — ${when}, ${time} ⚡`,
        "",
        `${acts} on the controls${support.length ? ` with ${support.join(" & ").toUpperCase()}` : ""}. Jungle, Hardcore, DNB, UKG & Bass music from Melbourne, live on KISS FM Australia, 87.8FM / 87.6FM.`,
        "",
        `${episodeCount}+ mixes from the archive ready to roll, plus shows, events, info and merch in one place.`,
        "",
        `Selectors on rotation — ${rotation}.`,
        "",
        "🎧 Stream live → https://kissfm.com.au",
        "🌀 Archive, events & merch → http://counterculture.vip",
        "📻 Or grab the KISS FM app",
        "",
        "Rewind, come again, tell ya friend."
      ].join("\n");
    };

    document.querySelector("#copy-blurb").addEventListener("click", async () => {
      const text = buildBlurb();
      downloadText(`counterculture-blurb-${getFormData(showForm).date || "tba"}.txt`, text);
      try {
        await navigator.clipboard.writeText(text);
        publishStatus.textContent = "Blurb copied to your clipboard and saved as a .txt. Paste straight into the post.";
      } catch (e) {
        publishStatus.textContent = "Blurb saved as a .txt next to your flyer.";
      }
    });

    document.querySelector("#download-flyer").addEventListener("click", downloadFlyer);

    document.querySelector("#export-json").addEventListener("click", () => {
      downloadText("counterculture-show-roster.json", JSON.stringify(state.slots, null, 2), "application/json");
    });

    document.querySelector("#export-csv").addEventListener("click", () => {
      const header = "date,time,title,residents,mcs,guests,status,venue,ticketUrl,notes";
      downloadText("counterculture-roster.csv", [header, ...state.slots.map(slotToCsv)].join("\r\n"), "text/csv");
    });

    document.querySelector("#export-calendar").addEventListener("click", exportCalendar);

    // Bios publish the same way bookings do: generate the data file the site
    // renders. Saved bios are matched to the residents already on the site by
    // name, so editing an existing one updates it rather than adding a double.
    // Picking an existing resident loads their current bio so it is edited
    // rather than replaced blind, and guarantees the name matches on publish.
    const bioArtist = document.querySelector("#bio-artist");
    const newNameWrap = document.querySelector("#bio-newname-wrap");

    bioArtist.addEventListener("change", () => {
      const val = bioArtist.value;
      newNameWrap.hidden = val !== "__new";
      if (!val || val === "__new") {
        refreshBioPreview();
        return;
      }
      const existing = (Array.isArray(siteDjs) ? siteDjs : []).find((d) => d.name === val);
      const draft = state.bios.find(
        (b) => String(b.artist || "").toLowerCase() === val.toLowerCase()
      );
      const src = draft || existing;
      if (!src) return;
      bioForm.elements.namedItem("role").value = src.role || "";
      bioForm.elements.namedItem("bio").value = draft ? draft.bio || "" : src.bio || "";
      bioForm.elements.namedItem("instagram").value = src.instagram || "";
      bioForm.elements.namedItem("mix").value = (draft ? draft.mix : src.mixcloud) || "";
      refreshBioPreview();
    });

    document.querySelector("#publish-bios").addEventListener("click", async () => {
      const norm = (v) => String(v || "").trim().toLowerCase();
      const merged = (Array.isArray(siteDjs) ? siteDjs : []).map((d) => {
        const edit = state.bios.find((b) => norm(b.artist) === norm(d.name));
        if (!edit) return d;
        return {
          ...d,
          role: String(edit.role || d.role).trim(),
          bio: String(edit.bio || d.bio).trim(),
          instagram: String(edit.instagram || d.instagram || "").trim(),
          mixcloud: String(edit.mix || d.mixcloud || "").trim()
        };
      });

      // Anyone in the bio drafts who is not already a resident gets appended.
      state.bios.forEach((b) => {
        if (merged.some((d) => norm(d.name) === norm(b.artist))) return;
        merged.push({
          name: String(b.artist || "").trim(),
          slug: slugify(b.artist),
          role: String(b.role || "Resident").trim(),
          bio: String(b.bio || "").trim(),
          instagram: String(b.instagram || "").trim(),
          mixcloud: String(b.mix || "").trim(),
          active: true
        });
      });

      const entry = (d) => `  {
    name: ${JSON.stringify(d.name)},
    slug: ${JSON.stringify(d.slug)},
    role: ${JSON.stringify(d.role)},
    bio: ${JSON.stringify(d.bio || "")},${d.instagram ? `\n    instagram: ${JSON.stringify(d.instagram)},` : ""}${d.mixcloud ? `\n    mixcloud: ${JSON.stringify(d.mixcloud)},` : ""}
    active: ${d.active !== false}
  }`;

      const text = `// GENERATED by "Publish bios" on /tools.
// Do not edit by hand.

export type DjRecord = {
  name: string;
  slug: string;
  role: string;
  bio: string;
  instagram?: string;
  mixcloud?: string;
  active: boolean;
};

export const djRecords: DjRecord[] = [
${merged.map(entry).join(",\n")}
];
`;

      downloadText("djs-data.ts", text, "text/plain");
      try {
        await navigator.clipboard.writeText(text);
        publishStatus.innerHTML =
          `Published bios for ${merged.length} residents. Copied to your clipboard and saved as djs-data.ts. ` +
          `Drop it into <code>src/data/djs-data.ts</code> and commit, or send it over.`;
      } catch (e) {
        publishStatus.textContent = `Saved djs-data.ts for ${merged.length} residents.`;
      }
    });

    document.querySelector("#export-bios").addEventListener("click", () => {
      downloadText("counterculture-bio-drafts.json", JSON.stringify(state.bios, null, 2), "application/json");
    });

    document.querySelector("#email-show").addEventListener("click", () => {
      const data = getFormData(showForm);
      const body = Object.entries(data)
        .filter(([key]) => key !== "id")
        .map(([key, value]) => `${key}: ${value}`)
        .join("\n");
      location.href = `mailto:${contactEmail}?subject=${encodeURIComponent("Counterculture show slot")}&body=${encodeURIComponent(body)}`;
    });

    document.querySelector("#email-bio").addEventListener("click", () => {
      const data = getFormData(bioForm);
      const body = Object.entries(data).filter(([key]) => key !== "image").map(([key, value]) => `${key}: ${value}`).join("\n");
      location.href = `mailto:${contactEmail}?subject=${encodeURIComponent("Counterculture crew bio")}&body=${encodeURIComponent(body)}`;
    });

    document.querySelector("#clear-drafts").addEventListener("click", () => {
      if (!confirm("Clear saved local drafts on this device?")) return;
      state.slots = seedSlots;
      state.bios = [];
      localStorage.removeItem(rosterKey);
      localStorage.removeItem(biosKey);
      renderRoster();
      refreshDrafts();
      setForm(state.slots.find((s) => s.residents) || state.slots[0] || blankSlot());
    });

    const loadCanvasLogo = (key, src) => {
      const image = new Image();
      image.onload = () => {
        state[key] = image;
        drawFlyer();
      };
      image.src = src;
    };

    // ---- Publish to the live site ----
    // The site renders src/data/roster.ts at build time, so publishing means
    // producing that file. Slots saved here live in this browser only until
    // they are published.
    const publishStatus = document.querySelector("#publish-status");

    const rosterFileFromSlots = () => {
      const mapStatus = (v) => {
        const s = String(v || "").toLowerCase();
        if (s.startsWith("confirm") || s.startsWith("lock")) return "Confirmed";
        if (s.startsWith("keen") || s.startsWith("pencil")) return "Pencilled";
        if (s.startsWith("induct")) return "Induction";
        return "Open Guest";
      };
      const booked = state.slots
        .filter((s) => s.date && String(s.residents || "").trim())
        .sort((a, b) => String(a.date).localeCompare(String(b.date)));

      const entries = booked
        .map(
          (s) => `  {
    date: ${JSON.stringify(s.date)},
    time: ${JSON.stringify(s.time || "12:00-1:30PM")},
    dj: ${JSON.stringify(String(s.residents || "").trim())},
    mc: ${JSON.stringify(String(s.mcs || "").trim())},
    guest: ${JSON.stringify(String(s.guests || "").trim())},
    status: ${JSON.stringify(mapStatus(s.status))},
    notes: ${JSON.stringify(String(s.notes || "").trim())}
  }`
        )
        .join(",\n");

      return {
        count: booked.length,
        text: `// GENERATED by "Publish to site" on /tools.
// Bookings only, all values literal. The types and upcomingSlots() live in
// roster.ts so publishing cannot remove an export the pages import.

export type RosterBooking = {
  date: string;
  time: string;
  dj: string;
  mc: string;
  guest: string;
  status: "Confirmed" | "Pencilled" | "Open Guest" | "Induction";
  notes: string;
};

export const bookings: RosterBooking[] = [
${entries}
];
`
      };
    };

    // The sheet is the live source: the front page reads it in the browser, so
    // a row pasted there appears on counterculture.vip within seconds, with no
    // build and no deploy. Columns are Date | Status | Heads.
    document.querySelector("#copy-sheet-row").addEventListener("click", async () => {
      const d = getFormData(showForm);
      if (!d.date || !String(d.residents || "").trim()) {
        publishStatus.textContent =
          "Add a date and at least one resident before copying a row.";
        return;
      }
      const [y, m, day] = d.date.split("-");
      const status = /confirm|lock/i.test(d.status) ? "Locked In" : "Keen";
      const heads = [d.residents, d.mcs, d.guests]
        .map((v) => String(v || "").trim())
        .filter(Boolean)
        .join(" & ");
      const row = `${Number(day)}/${Number(m)}/${y}\t${status}\t${heads}`;
      try {
        await navigator.clipboard.writeText(row);
        publishStatus.innerHTML =
          `Row copied: <code>${row.replace(/\t/g, "  |  ")}</code><br>` +
          `Paste it into the crew sheet. The site reads the sheet live, so it shows up on the front page within seconds — no deploy needed.`;
      } catch (e) {
        publishStatus.textContent = "Copy this row into the sheet: " + row.replace(/\t/g, "  |  ");
      }
    });

    document.querySelector("#publish-site").addEventListener("click", async () => {
      const { count, text } = rosterFileFromSlots();
      if (!count) {
        publishStatus.textContent =
          "Nothing to publish — a slot needs a date and at least one resident.";
        return;
      }
      downloadText("roster-data.ts", text, "text/plain");
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch (e) {}
      publishStatus.innerHTML =
        `Published file for ${count} booking${count === 1 ? "" : "s"}. ` +
        (copied ? "Copied to your clipboard and downloaded as roster.ts. " : "Downloaded as roster.ts. ") +
        `Drop it into <code>src/data/roster-data.ts</code> and commit, or paste it to Rob. ` +
        `The site rebuilds and the front page updates within about a minute.`;
    });

    // ---- Events ----
    const eventForm = document.querySelector("#event-form");
    const eventImageInput = document.querySelector("#event-image");
    const eventsKey = "cc-events";
    state.events = JSON.parse(localStorage.getItem(eventsKey) || "[]");

    const renderEvents = () => {
      const list = document.querySelector("#event-list");
      const sorted = [...state.events].sort((a, b) => String(a.date).localeCompare(String(b.date)));
      list.innerHTML = sorted.length
        ? sorted
            .map(
              (item) =>
                `<p><strong>${formatDate(item.date)}</strong><br>${item.name || "Untitled event"}<br>${[item.venue, item.city].filter(Boolean).join(", ")}${item.lineup ? `<br>${item.lineup}` : ""}</p>`
            )
            .join("")
        : "<p>No events saved yet.</p>";
    };

    eventImageInput.addEventListener("change", () => {
      const file = eventImageInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        document.querySelector("#event-preview-image").src = String(reader.result);
        state.eventImage = String(reader.result);
      };
      reader.readAsDataURL(file);
    });

    eventForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = {
        ...getFormData(eventForm),
        id: `event-${Date.now()}`,
        image: state.eventImage || null,
        savedAt: new Date().toISOString()
      };
      state.events.unshift(data);
      localStorage.setItem(eventsKey, JSON.stringify(state.events));
      renderEvents();
      eventForm.reset();
    });

    document.querySelector("#email-event").addEventListener("click", () => {
      const data = getFormData(eventForm);
      const body = Object.entries(data)
        .filter(([key]) => key !== "image")
        .map(([key, value]) => `${key}: ${value}`)
        .join("\n");
      location.href = `mailto:${contactEmail}?subject=${encodeURIComponent("Counterculture event")}&body=${encodeURIComponent(body)}`;
    });

    document.querySelector("#export-events").addEventListener("click", () => {
      downloadText("counterculture-events.json", JSON.stringify(state.events, null, 2), "application/json");
    });

    document.querySelector("#events-calendar").addEventListener("click", () => {
      const events = state.events
        .filter((item) => item.date)
        .map((item) => {
          const date = item.date.replaceAll("-", "");
          const description = [item.lineup, item.entry, item.notes, item.ticketUrl].filter(Boolean).join("\n");
          return [
            "BEGIN:VEVENT",
            `UID:${item.id}@counterculture.vip`,
            `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "")}`,
            `DTSTART;VALUE=DATE:${date}`,
            `SUMMARY:${item.name || "Counterculture event"}`,
            `LOCATION:${[item.venue, item.city].filter(Boolean).join(", ")}`,
            `DESCRIPTION:${description.replace(/\n/g, "\\n")}`,
            "END:VEVENT"
          ].join("\r\n");
        })
        .join("\r\n");
      downloadText(
        "counterculture-events.ics",
        `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Counterculture//Events//EN\r\n${events}\r\nEND:VCALENDAR`,
        "text/calendar"
      );
    });

    renderEvents();

    loadCanvasLogo("counterweightLogo", "/assets/counterweight-logo-orange.png");
    loadCanvasLogo("kissLogo", "/assets/kiss-logo-black.png");
    localStorage.setItem(biosKey, JSON.stringify(state.bios));
    saveSlots();
    renderRoster();
    refreshBioPreview();
    refreshDrafts();
    setForm(state.slots.find((s) => s.residents) || state.slots[0] || blankSlot());
  </script>
</BaseLayout>
