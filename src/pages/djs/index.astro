---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DjCard from "../../components/DjCard.astro";
import { djs } from "../../data/djs";
---

<BaseLayout title="Residents">
  <section class="page-title">
    <div>
      <p class="kicker">Counterculture crew</p>
      <h1>Residents</h1>
    </div>
  </section>
  <section class="section">
    <div class="grid dj-grid">
      {djs.map((dj) => <DjCard dj={dj} />)}
    </div>
  </section>
</BaseLayout>
