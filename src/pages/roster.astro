---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShowCard from "../components/ShowCard.astro";
import { upcomingSlots, SHOW_TIME as SHOW_TIME_LABEL } from "../data/roster";
---

<BaseLayout title="Roster">
  <section class="page-title">
    <div>
      <p class="kicker">Saturdays · KISS FM Australia</p>
      <h1>Show <span>Roster</span></h1>
    </div>
  </section>
  <section class="content-band intro-band">
    <p>
      Counterculture airs every Saturday, {SHOW_TIME_LABEL} on Kiss FM Australia.
      The crew is mid-restructure, so most slots below are open. Line-ups appear
      here as they are locked in.
    </p>
  </section>
  <section class="section">
    <div class="grid">
      {upcomingSlots(8).map((show) => <ShowCard show={show} />)}
    </div>
  </section>
</BaseLayout>
