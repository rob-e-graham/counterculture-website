---
// The real Counterculture counterweight mark. The supplied artwork is orange
// with transparent knockouts, so the artwork is filtered to black and the disc
// colour sits behind it, showing through the ticks and lettering. That keeps
// the mark in the site palette instead of introducing a lone orange.
type Props = {
  class?: string;
  bg?: string;
  alt?: string;
  loading?: "eager" | "lazy";
};

const {
  class: className = "",
  bg,
  alt = "Counterculture Melbourne",
  loading = "lazy"
} = Astro.props;
---

<span class={`dial-mark ${className}`} style={bg ? `background:${bg}` : undefined}>
  <img
    class="dial-mark-img"
    src="/assets/counterweight-logo-orange.png"
    alt={alt}
    width="960"
    height="960"
    loading={loading}
    decoding="async"
  />
</span>
