---
// The real Counterculture counterweight mark. Colour variants are produced by
// hue-rotating the brand orange rather than redrawing the artwork.
type Props = {
  class?: string;
  hue?: number;
  alt?: string;
  loading?: "eager" | "lazy";
};

const {
  class: className = "",
  hue = 0,
  alt = "Counterculture Melbourne",
  loading = "lazy"
} = Astro.props;
---

<img
  class={`dial-mark ${className}`}
  src="/assets/counterweight-logo-orange.png"
  alt={alt}
  width="960"
  height="960"
  loading={loading}
  decoding="async"
  style={hue ? `filter: hue-rotate(${hue}deg)` : undefined}
/>
