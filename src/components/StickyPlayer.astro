---
// Global "now playing" bar. Any element with data-cc-play="<mixcloudKey>"
// (and optional data-cc-title) plays that show here via the Mixcloud Widget API.
// The iframe is injected on first play so every page stays fast until used.
---

<div id="cc-player" class="cc-player" hidden aria-live="polite">
  <div class="cc-player-inner">
    <div class="cc-player-meta">
      <svg id="cc-record" class="cc-cassette" viewBox="0 0 96 62" aria-hidden="true">
        <rect x="1" y="1" width="94" height="60" rx="5" fill="#111" stroke="#3a3a3a" />
        <rect x="7" y="7" width="82" height="30" rx="3" fill="#0a0a0a" stroke="#333" />
        <!-- Reel windows: the hubs turn while audio plays. -->
        <g class="cc-reel-group">
          <circle cx="30" cy="22" r="10.5" fill="#1a1a1a" stroke="#3a3a3a" />
          <g class="cc-reel">
            <circle cx="30" cy="22" r="5.4" fill="#92ff00" />
            <g stroke="#0a0a0a" stroke-width="1.6">
              <line x1="30" y1="16.6" x2="30" y2="27.4" />
              <line x1="24.6" y1="22" x2="35.4" y2="22" />
              <line x1="26.2" y1="18.2" x2="33.8" y2="25.8" />
              <line x1="26.2" y1="25.8" x2="33.8" y2="18.2" />
            </g>
          </g>
          <circle cx="66" cy="22" r="10.5" fill="#1a1a1a" stroke="#3a3a3a" />
          <g class="cc-reel">
            <circle cx="66" cy="22" r="5.4" fill="#92ff00" />
            <g stroke="#0a0a0a" stroke-width="1.6">
              <line x1="66" y1="16.6" x2="66" y2="27.4" />
              <line x1="60.6" y1="22" x2="71.4" y2="22" />
              <line x1="62.2" y1="18.2" x2="69.8" y2="25.8" />
              <line x1="62.2" y1="25.8" x2="69.8" y2="18.2" />
            </g>
          </g>
        </g>
        <rect x="14" y="43" width="68" height="12" rx="2" fill="#1c1c1c" />
        <rect x="20" y="47" width="24" height="1.6" fill="#4a4a4a" />
        <rect x="20" y="50.5" width="16" height="1.6" fill="#3a3a3a" />
        <circle cx="74" cy="49" r="3" fill="#0a0a0a" stroke="#3a3a3a" />
      </svg>
      <div class="cc-player-text">
        <span class="cc-player-eyebrow">Now playing</span>
        <span id="cc-player-title" class="cc-player-title">Counterculture</span>
      </div>
    </div>
    <div id="cc-player-slot" class="cc-player-slot"></div>
    <button id="cc-player-close" class="cc-player-close" type="button" aria-label="Close player">×</button>
  </div>
</div>

<script is:inline>
  (function () {
    var frame = null;
    var widget = null;
    var apiLoading = null;

    function loadApi() {
      if (window.Mixcloud) return Promise.resolve();
      if (apiLoading) return apiLoading;
      apiLoading = new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = "https://widget.mixcloud.com/media/js/widgetApi.js";
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
      return apiLoading;
    }

    // Full (non-mini) widget: shows the Mixcloud waveform + playhead position.
    function feedSrc(key, autoplay) {
      return (
        "https://www.mixcloud.com/widget/iframe/?hide_cover=1&light=0" +
        (autoplay ? "&autoplay=1" : "") +
        "&feed=" +
        encodeURIComponent(key)
      );
    }

    window.ccPlay = function (key, title) {
      if (!key) return;
      var bar = document.getElementById("cc-player");
      var slot = document.getElementById("cc-player-slot");
      var titleEl = document.getElementById("cc-player-title");
      if (!bar || !slot) return;

      bar.hidden = false;
      void bar.offsetWidth; // force reflow so the slide-up transition runs
      bar.classList.add("is-active");
      if (titleEl) titleEl.textContent = title || "Counterculture";

      if (!frame) {
        frame = document.createElement("iframe");
        frame.id = "cc-player-frame";
        frame.title = "Counterculture Mixcloud player";
        frame.setAttribute("width", "100%");
        frame.setAttribute("height", "120");
        frame.setAttribute("frameborder", "0");
        frame.allow = "autoplay; encrypted-media; fullscreen";
        frame.src = feedSrc(key, true);
        slot.appendChild(frame);
        loadApi()
          .then(function () {
            widget = window.Mixcloud.PlayerWidget(frame);
            return widget.ready;
          })
          .then(function () {
            // Spin the record only while audio is actually playing.
            var record = document.getElementById("cc-record");
            widget.events.play.on(function () {
              if (record) record.classList.add("is-spinning");
            });
            widget.events.pause.on(function () {
              if (record) record.classList.remove("is-spinning");
            });
            widget.events.ended.on(function () {
              if (record) record.classList.remove("is-spinning");
            });
          })
          .catch(function () {});
      } else if (widget) {
        widget.ready
          .then(function () {
            return widget.load(key, true);
          })
          .catch(function () {
            frame.src = feedSrc(key, true);
          });
      } else {
        frame.src = feedSrc(key, true);
      }
    };

    document.addEventListener("click", function (e) {
      var el = e.target.closest("[data-cc-play]");
      if (el) {
        e.preventDefault();
        window.ccPlay(el.getAttribute("data-cc-play"), el.getAttribute("data-cc-title") || "");
        return;
      }
      if (e.target.closest("#cc-player-close")) {
        var bar = document.getElementById("cc-player");
        if (widget) {
          widget.ready.then(function () {
            widget.pause();
          }).catch(function () {});
        }
        if (bar) bar.classList.remove("is-active");
      }
    });
  })();
</script>
