---
import type { RosterItem } from "../data/roster";

type Props = {
  show: RosterItem;
};

const { show } = Astro.props;
const date = new Date(`${show.date}T12:00:00`);
const month = date.toLocaleDateString("en-AU", { month: "short" });
const day = date.toLocaleDateString("en-AU", { day: "2-digit" });
const guest = show.guest && show.guest !== "TBA" ? show.guest : "";
const statusClass = show.status.toLowerCase().replace(/\s+/g, "-");
---

<article class="show-card">
  <time datetime={show.date} class="date-tile">
    <span>{month}</span>
    <strong>{day}</strong>
  </time>
  <div class="show-card-body">
    {/* Matches the hero: "Confirmed" is internal roster state, so only badge
        the statuses that tell the public something. */}
    {show.status !== "Confirmed" && (
      <span class={`status status-${statusClass}`}>{show.status}</span>
    )}
    <h3>{show.dj}</h3>
    <p class="show-card-meta">{show.mc}{guest ? ` · Guest: ${guest}` : ""}</p>
    <small>{show.time}</small>
  </div>
</article>
