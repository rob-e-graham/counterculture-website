---
import DialMark from "./DialMark.astro";

// Cover for an episode: the dial on a coloured disc, with the date set below.
// Colour is driven by position in the list using the golden angle, so
// neighbouring covers never land on similar hues.
type Props = {
  slug: string;
  date: string;
  dj?: string;
  index?: number;
};

const { date, dj, index = 0 } = Astro.props;

const hue = Math.round((index * 137.508) % 360);
const color = `hsl(${hue} 85% 58%)`;

const d = new Date(`${date}T12:00:00`);
const day = String(d.getDate()).padStart(2, "0");
const month = d.toLocaleDateString("en-AU", { month: "short" }).toUpperCase();
const year = d.getFullYear();
const label = (dj && dj !== "Counterculture Crew" ? dj : "Counterculture")
  .toUpperCase()
  .slice(0, 24);
---

<div class="episode-art" style={`--art-color:${color}`}>
  <DialMark class="episode-art-dial" bg={color} alt="" />
  <div class="episode-art-label">
    <span class="episode-art-date">{day} {month}</span>
    <span class="episode-art-year">{year}</span>
    <span class="episode-art-dj">{label}</span>
  </div>
</div>
