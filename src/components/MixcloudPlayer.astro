---
type Props = {
  mixcloudKey: string;
  title: string;
};

const { mixcloudKey, title } = Astro.props;
// Point straight at player-widget.mixcloud.com. www.mixcloud.com/widget/iframe/
// cross-origin redirects here and drops the path, which fails inside in-app
// webviews like Messenger ("Sorry we can't find that content").
// light=0 keeps the embed on its dark theme so it sits in the page.
const src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&light=0&feed=${encodeURIComponent(
  mixcloudKey
)}`;
---

<iframe
  class="mixcloud-player"
  title={`Mixcloud player for ${title}`}
  src={src}
  width="100%"
  height="60"
  frameborder="0"
  loading="lazy"
  allow="autoplay"
></iframe>
