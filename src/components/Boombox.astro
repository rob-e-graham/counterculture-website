---
// Boombox that plays a random show from the archive through the sticky player.
// Modelled on the 80s Lasonic-style ghetto blaster: chrome speaker rings with
// crossbars, wide tuning dial, double cassette deck, graphic EQ.
type Props = {
  shows: { mixcloudKey: string; title: string }[];
};

const { shows } = Astro.props;
const payload = JSON.stringify(
  shows.map((s) => ({ k: s.mixcloudKey, t: s.title }))
);

const dialTicks = Array.from({ length: 25 }, (_, i) => 30 + i * 14);
const dialNums = ["88", "92", "96", "100", "104", "108"];
const faders = [0, 1, 2, 3, 4, 5, 6];
---

<div class="boombox-wrap">
  <button
    class="boombox"
    type="button"
    id="cc-boombox"
    data-shows={payload}
    aria-label="Play a random show from the archive"
  >
    <svg viewBox="0 0 420 218" aria-hidden="true">
      <defs>
        <linearGradient id="bbChrome" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f2f2f4" />
          <stop offset="0.28" stop-color="#9a9aa0" />
          <stop offset="0.5" stop-color="#e8e8ec" />
          <stop offset="0.74" stop-color="#7c7c82" />
          <stop offset="1" stop-color="#cfcfd4" />
        </linearGradient>
        <linearGradient id="bbShell" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#333336" />
          <stop offset="0.3" stop-color="#1c1c1f" />
          <stop offset="1" stop-color="#0a0a0b" />
        </linearGradient>
        <radialGradient id="bbDish" cx="0.4" cy="0.32" r="0.8">
          <stop offset="0" stop-color="#3a3a3e" />
          <stop offset="0.6" stop-color="#1a1a1d" />
          <stop offset="1" stop-color="#0b0b0c" />
        </radialGradient>
        <radialGradient id="bbCone" cx="0.4" cy="0.35" r="0.75">
          <stop offset="0" stop-color="#d6ff8a" />
          <stop offset="0.5" stop-color="#92ff00" />
          <stop offset="1" stop-color="#4a8200" />
        </radialGradient>
        <pattern id="bbMesh" width="4" height="4" patternUnits="userSpaceOnUse">
          <circle cx="1.3" cy="1.3" r="0.7" fill="#26262a" />
        </pattern>
      </defs>

      <!-- antenna -->
      <g stroke="#8e8e94" stroke-linecap="round">
        <line x1="366" y1="34" x2="410" y2="6" stroke-width="2.4" />
        <circle cx="411" cy="5" r="2.4" fill="#c8c8ce" stroke="none" />
      </g>

      <!-- squared carry handle -->
      <g fill="none" stroke="url(#bbChrome)" stroke-width="7" stroke-linejoin="round">
        <path d="M150 34V16h120v18" />
      </g>
      <rect x="146" y="30" width="12" height="10" rx="2" fill="#4a4a50" />
      <rect x="262" y="30" width="12" height="10" rx="2" fill="#4a4a50" />

      <!-- shell -->
      <rect x="6" y="38" width="408" height="164" rx="10" fill="url(#bbShell)" stroke="#52525a" stroke-width="2" />
      <rect x="6" y="38" width="408" height="2.5" rx="1.2" fill="#6e6e76" opacity="0.6" />

      <!-- tuning dial across the top -->
      <rect x="20" y="46" width="380" height="26" rx="3" fill="#0b0f07" stroke="url(#bbChrome)" stroke-width="1.2" />
      <g stroke="#5c6b4a">
        {dialTicks.map((x, i) => (
          <line x1={x} y1={i % 4 === 0 ? 52 : 56} x2={x} y2={62} stroke-width={i % 4 === 0 ? 1.3 : 0.8} />
        ))}
      </g>
      <g fill="#8fa07a" font-family="Arial, sans-serif" font-size="6.5" text-anchor="middle">
        {dialNums.map((n, i) => <text x={44 + i * 62} y="70">{n}</text>)}
      </g>
      <line class="bb-tuner" x1="150" y1="48" x2="150" y2="70" stroke="#ff3b30" stroke-width="2" />
      <text x="374" y="70" fill="#5c6b4a" font-family="Arial, sans-serif" font-size="6" text-anchor="middle">FM</text>

      <!-- left speaker -->
      <g>
        <circle cx="76" cy="134" r="58" fill="url(#bbChrome)" />
        <circle cx="76" cy="134" r="52" fill="url(#bbDish)" stroke="#46464c" stroke-width="1.2" />
        <circle cx="76" cy="134" r="47" fill="url(#bbMesh)" />
        <circle cx="76" cy="134" r="34" fill="none" stroke="#313136" stroke-width="1.2" />
        <circle class="bb-cone" cx="76" cy="134" r="19" fill="url(#bbCone)" />
        <circle cx="76" cy="134" r="5" fill="#0a0a0a" />
        <!-- chrome crossbar strut -->
        <rect x="72.5" y="76" width="7" height="116" rx="3.5" fill="url(#bbChrome)" opacity="0.95" />
        <circle cx="76" cy="134" r="9" fill="url(#bbChrome)" />
      </g>

      <!-- right speaker -->
      <g>
        <circle cx="344" cy="134" r="58" fill="url(#bbChrome)" />
        <circle cx="344" cy="134" r="52" fill="url(#bbDish)" stroke="#46464c" stroke-width="1.2" />
        <circle cx="344" cy="134" r="47" fill="url(#bbMesh)" />
        <circle cx="344" cy="134" r="34" fill="none" stroke="#313136" stroke-width="1.2" />
        <circle class="bb-cone" cx="344" cy="134" r="19" fill="url(#bbCone)" />
        <circle cx="344" cy="134" r="5" fill="#0a0a0a" />
        <rect x="340.5" y="76" width="7" height="116" rx="3.5" fill="url(#bbChrome)" opacity="0.95" />
        <circle cx="344" cy="134" r="9" fill="url(#bbChrome)" />
      </g>

      <!-- centre console -->
      <rect x="142" y="78" width="136" height="116" rx="4" fill="#151518" stroke="url(#bbChrome)" stroke-width="1.2" />

      <!-- graphic EQ faders -->
      <rect x="148" y="84" width="124" height="30" rx="2" fill="#0c0c0e" stroke="#33333a" />
      <g stroke="#33333a" stroke-width="0.9">
        {faders.map((i) => <line x1={158 + i * 17} y1="88" x2={158 + i * 17} y2="110" />)}
      </g>
      <g class="bb-eq" fill="#92ff00">
        {faders.map((i) => <rect x={154.5 + i * 17} y="95" width="7" height="4" rx="1" />)}
      </g>

      <!-- double cassette deck -->
      <rect x="148" y="120" width="60" height="40" rx="2.5" fill="#0c0c0e" stroke="#33333a" />
      <rect x="212" y="120" width="60" height="40" rx="2.5" fill="#0c0c0e" stroke="#33333a" />
      <text x="178" y="128" fill="#6a6a70" font-family="Arial, sans-serif" font-size="5" text-anchor="middle">DECK A</text>
      <text x="242" y="128" fill="#6a6a70" font-family="Arial, sans-serif" font-size="5" text-anchor="middle">DECK B</text>
      <g class="bb-reel">
        <circle cx="166" cy="144" r="7.5" fill="#17171a" stroke="#4a4a50" />
        <circle cx="166" cy="144" r="3" fill="#92ff00" />
        <g stroke="#0a0a0a" stroke-width="1"><line x1="166" y1="141" x2="166" y2="147" /><line x1="163" y1="144" x2="169" y2="144" /></g>
      </g>
      <g class="bb-reel">
        <circle cx="190" cy="144" r="7.5" fill="#17171a" stroke="#4a4a50" />
        <circle cx="190" cy="144" r="3" fill="#92ff00" />
        <g stroke="#0a0a0a" stroke-width="1"><line x1="190" y1="141" x2="190" y2="147" /><line x1="187" y1="144" x2="193" y2="144" /></g>
      </g>
      <g class="bb-reel">
        <circle cx="230" cy="144" r="7.5" fill="#17171a" stroke="#4a4a50" />
        <circle cx="230" cy="144" r="3" fill="#5a5a60" />
      </g>
      <g class="bb-reel">
        <circle cx="254" cy="144" r="7.5" fill="#17171a" stroke="#4a4a50" />
        <circle cx="254" cy="144" r="3" fill="#5a5a60" />
      </g>

      <!-- piano-key transport row -->
      <g fill="url(#bbChrome)" stroke="#5a5a60" stroke-width="0.6">
        <rect x="148" y="166" width="16" height="11" rx="1.5" />
        <rect x="166" y="166" width="16" height="11" rx="1.5" />
        <rect x="184" y="166" width="16" height="11" rx="1.5" />
        <rect x="202" y="166" width="16" height="11" rx="1.5" />
        <rect x="220" y="166" width="16" height="11" rx="1.5" />
        <rect x="238" y="166" width="16" height="11" rx="1.5" />
      </g>
      <rect x="256" y="166" width="16" height="11" rx="1.5" fill="#a3242f" stroke="#c8323f" stroke-width="0.6" />

      <!-- side knobs and badges -->
      <g>
        <circle cx="112" cy="188" r="7.5" fill="url(#bbChrome)" />
        <circle cx="112" cy="188" r="5" fill="#1c1c20" />
        <line x1="112" y1="188" x2="112" y2="184" stroke="#92ff00" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="308" cy="188" r="7.5" fill="url(#bbChrome)" />
        <circle cx="308" cy="188" r="5" fill="#1c1c20" />
        <line x1="308" y1="188" x2="311" y2="185" stroke="#92ff00" stroke-width="1.5" stroke-linecap="round" />
      </g>
      <text x="76" y="200" fill="#6a6a70" font-family="Arial, sans-serif" font-size="5.5" text-anchor="middle" letter-spacing="1">HIGH FIDELITY</text>
      <text x="344" y="200" fill="#6a6a70" font-family="Arial, sans-serif" font-size="5.5" text-anchor="middle" letter-spacing="1">STEREO</text>
      <text x="210" y="188" fill="#92ff00" font-family="Arial, sans-serif" font-size="6" text-anchor="middle" letter-spacing="0.5">COUNTERCULTURE</text>

      <!-- feet -->
      <rect x="40" y="202" width="34" height="6" rx="2.5" fill="#141416" />
      <rect x="346" y="202" width="34" height="6" rx="2.5" fill="#141416" />
    </svg>
    <span class="boombox-label">▶ Play a random show</span>
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("cc-boombox");
    if (!btn) return;
    var shows = [];
    try {
      shows = JSON.parse(btn.getAttribute("data-shows") || "[]");
    } catch (e) {}
    var last = -1;
    btn.addEventListener("click", function () {
      if (!shows.length || typeof window.ccPlay !== "function") return;
      var i = Math.floor(Math.random() * shows.length);
      // Avoid repeating the same show twice in a row.
      if (shows.length > 1 && i === last) i = (i + 1) % shows.length;
      last = i;
      window.ccPlay(shows[i].k, shows[i].t);
    });
  })();
</script>
