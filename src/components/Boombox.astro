---
// Boombox that plays a random show from the archive through the sticky player.
// 80s Lasonic-style ghetto blaster: chrome speaker rings with crossbar struts,
// four-way drivers, wide FM dial, double cassette, graphic EQ, sticker slaps.
type Props = {
  shows: { mixcloudKey: string; title: string }[];
};

const { shows } = Astro.props;
const payload = JSON.stringify(
  shows.map((s) => ({ k: s.mixcloudKey, t: s.title }))
);

const dialTicks = Array.from({ length: 27 }, (_, i) => 34 + i * 14);
const dialNums = ["86", "90", "94", "98", "102", "106"];
const faders = [0, 1, 2, 3, 4, 5, 6];
const ports = [0, 1, 2, 3];
---

<div class="boombox-wrap">
  <button
    class="boombox"
    type="button"
    id="cc-boombox"
    data-shows={payload}
    aria-label="Play a random show from the archive"
  >
    <svg viewBox="0 0 440 250" aria-hidden="true">
      <defs>
        <linearGradient id="bbChrome" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="0.22" stop-color="#8e8e95" />
          <stop offset="0.48" stop-color="#f4f4f7" />
          <stop offset="0.72" stop-color="#66666d" />
          <stop offset="1" stop-color="#d8d8de" />
        </linearGradient>
        <linearGradient id="bbBrass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f6e3a0" />
          <stop offset="0.45" stop-color="#c9a13c" />
          <stop offset="1" stop-color="#8a6a1c" />
        </linearGradient>
        <linearGradient id="bbShell" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3a3a3e" />
          <stop offset="0.26" stop-color="#1d1d20" />
          <stop offset="1" stop-color="#080809" />
        </linearGradient>
        <radialGradient id="bbDish" cx="0.4" cy="0.3" r="0.82">
          <stop offset="0" stop-color="#404045" />
          <stop offset="0.58" stop-color="#191a1d" />
          <stop offset="1" stop-color="#0a0a0b" />
        </radialGradient>
        <radialGradient id="bbCone" cx="0.4" cy="0.34" r="0.76">
          <stop offset="0" stop-color="#e2ffa6" />
          <stop offset="0.48" stop-color="#92ff00" />
          <stop offset="1" stop-color="#40700a" />
        </radialGradient>
        <pattern id="bbMesh" width="4" height="4" patternUnits="userSpaceOnUse">
          <circle cx="1.3" cy="1.3" r="0.72" fill="#25252a" />
        </pattern>
      </defs>

      <!-- squared carry handle with shoulder strap lugs -->
      <g fill="none" stroke="url(#bbChrome)" stroke-width="8" stroke-linejoin="round">
        <path d="M156 40V18h128v22" />
      </g>
      <rect x="150" y="34" width="14" height="12" rx="2" fill="#4e4e55" />
      <rect x="276" y="34" width="14" height="12" rx="2" fill="#4e4e55" />
      <circle cx="20" cy="60" r="4" fill="none" stroke="url(#bbBrass)" stroke-width="2" />
      <circle cx="420" cy="60" r="4" fill="none" stroke="url(#bbBrass)" stroke-width="2" />

      <!-- shell -->
      <rect x="6" y="46" width="428" height="184" rx="11" fill="url(#bbShell)" stroke="#5c5c66" stroke-width="2.5" />
      <rect x="6" y="46" width="428" height="3" rx="1.5" fill="#7c7c86" opacity="0.65" />
      <!-- scuffs -->
      <g stroke="#6a6a72" stroke-linecap="round" opacity="0.28">
        <line x1="30" y1="222" x2="58" y2="220" stroke-width="1.4" />
        <line x1="398" y1="52" x2="416" y2="54" stroke-width="1.2" />
        <line x1="14" y1="120" x2="16" y2="150" stroke-width="1.2" />
      </g>

      <!-- FM tuning dial -->
      <rect x="24" y="54" width="392" height="26" rx="3" fill="#0a0e06" stroke="url(#bbChrome)" stroke-width="1.4" />
      <g stroke="#5f6f4c">
        {dialTicks.map((x, i) => (
          <line x1={x} y1={i % 4 === 0 ? 60 : 64} x2={x} y2={70} stroke-width={i % 4 === 0 ? 1.3 : 0.8} />
        ))}
      </g>
      <g fill="#93a47c" font-family="Arial, sans-serif" font-size="6.5" text-anchor="middle">
        {dialNums.map((n, i) => <text x={94 + i * 58} y="78">{n}</text>)}
      </g>
      <!-- Kiss FM is 87.8. On the scale above 86 sits at x=94 at 14.5px per
           MHz, so 87.8 lands at 94 + 1.8 * 14.5 = 120.1. -->
      <line class="bb-tuner" x1="120.1" y1="56" x2="120.1" y2="78" stroke="#ff3b30" stroke-width="2.4" />
      <text x="392" y="70" fill="#5f6f4c" font-family="Arial, sans-serif" font-size="6" text-anchor="middle">FM</text>

      <!-- left driver stack -->
      <g>
        <circle cx="82" cy="96" r="16" fill="url(#bbChrome)" />
        <circle cx="82" cy="96" r="12" fill="#141417" stroke="#3a3a40" />
        <circle cx="82" cy="96" r="4.5" fill="#92ff00" opacity="0.8" />
        <circle cx="82" cy="164" r="60" fill="url(#bbChrome)" />
        <circle cx="82" cy="164" r="54" fill="url(#bbDish)" stroke="#4a4a52" stroke-width="1.3" />
        <circle cx="82" cy="164" r="49" fill="url(#bbMesh)" />
        <circle cx="82" cy="164" r="36" fill="none" stroke="#32323a" stroke-width="1.2" />
        <circle class="bb-cone" cx="82" cy="164" r="20" fill="url(#bbCone)" />
        <circle cx="82" cy="164" r="5" fill="#08080a" />
        <rect x="78" y="104" width="8" height="120" rx="4" fill="url(#bbChrome)" />
        <circle cx="82" cy="164" r="10" fill="url(#bbChrome)" />
      </g>

      <!-- right driver stack -->
      <g>
        <circle cx="358" cy="96" r="16" fill="url(#bbChrome)" />
        <circle cx="358" cy="96" r="12" fill="#141417" stroke="#3a3a40" />
        <circle cx="358" cy="96" r="4.5" fill="#92ff00" opacity="0.8" />
        <circle cx="358" cy="164" r="60" fill="url(#bbChrome)" />
        <circle cx="358" cy="164" r="54" fill="url(#bbDish)" stroke="#4a4a52" stroke-width="1.3" />
        <circle cx="358" cy="164" r="49" fill="url(#bbMesh)" />
        <circle cx="358" cy="164" r="36" fill="none" stroke="#32323a" stroke-width="1.2" />
        <circle class="bb-cone" cx="358" cy="164" r="20" fill="url(#bbCone)" />
        <circle cx="358" cy="164" r="5" fill="#08080a" />
        <rect x="354" y="104" width="8" height="120" rx="4" fill="url(#bbChrome)" />
        <circle cx="358" cy="164" r="10" fill="url(#bbChrome)" />
      </g>

      <!-- centre console -->
      <rect x="152" y="88" width="136" height="128" rx="4" fill="#141417" stroke="url(#bbChrome)" stroke-width="1.3" />

      <!-- brand plate, centred on the console -->
      <circle class="bb-led" cx="162" cy="96" r="2.6" fill="#ff3b30" />
      <text x="220" y="99" fill="url(#bbBrass)" font-family="Arial, sans-serif" font-size="7" font-weight="bold" text-anchor="middle" letter-spacing="1.1">COUNTERCULTURE</text>

      <!-- graphic EQ -->
      <rect x="158" y="102" width="124" height="30" rx="2" fill="#0b0b0d" stroke="#35353c" />
      <g stroke="#35353c" stroke-width="0.9">
        {faders.map((i) => <line x1={168 + i * 17} y1="106" x2={168 + i * 17} y2="128" />)}
      </g>
      <g class="bb-eq" fill="#92ff00">
        {faders.map((i) => <rect x={164.5 + i * 17} y="113" width="7" height="4" rx="1" />)}
      </g>

      <!-- double cassette: both decks identical -->
      <rect x="158" y="138" width="60" height="40" rx="2.5" fill="#0b0b0d" stroke="#35353c" />
      <rect x="222" y="138" width="60" height="40" rx="2.5" fill="#0b0b0d" stroke="#35353c" />
      <text x="188" y="146" fill="#71717a" font-family="Arial, sans-serif" font-size="5" text-anchor="middle">DECK A</text>
      <text x="252" y="146" fill="#71717a" font-family="Arial, sans-serif" font-size="5" text-anchor="middle">DECK B</text>
      <g class="bb-reel">
        <circle cx="176" cy="162" r="7.5" fill="#17171a" stroke="#50505a" />
        <circle cx="176" cy="162" r="3" fill="#92ff00" />
        <g stroke="#08080a" stroke-width="1"><line x1="176" y1="159" x2="176" y2="165" /><line x1="173" y1="162" x2="179" y2="162" /></g>
      </g>
      <g class="bb-reel">
        <circle cx="200" cy="162" r="7.5" fill="#17171a" stroke="#50505a" />
        <circle cx="200" cy="162" r="3" fill="#92ff00" />
        <g stroke="#08080a" stroke-width="1"><line x1="200" y1="159" x2="200" y2="165" /><line x1="197" y1="162" x2="203" y2="162" /></g>
      </g>
      <g class="bb-reel bb-reel-idle">
        <circle cx="240" cy="162" r="7.5" fill="#17171a" stroke="#50505a" />
        <circle cx="240" cy="162" r="3" fill="#92ff00" />
        <g stroke="#08080a" stroke-width="1"><line x1="240" y1="159" x2="240" y2="165" /><line x1="237" y1="162" x2="243" y2="162" /></g>
      </g>
      <g class="bb-reel bb-reel-idle">
        <circle cx="264" cy="162" r="7.5" fill="#17171a" stroke="#50505a" />
        <circle cx="264" cy="162" r="3" fill="#92ff00" />
        <g stroke="#08080a" stroke-width="1"><line x1="264" y1="159" x2="264" y2="165" /><line x1="261" y1="162" x2="267" y2="162" /></g>
      </g>

      <!-- piano-key transport -->
      <g fill="url(#bbChrome)" stroke="#5a5a64" stroke-width="0.6">
        <rect x="158" y="184" width="16" height="12" rx="1.5" />
        <rect x="176" y="184" width="16" height="12" rx="1.5" />
        <rect x="194" y="184" width="16" height="12" rx="1.5" />
        <rect x="212" y="184" width="16" height="12" rx="1.5" />
        <rect x="230" y="184" width="16" height="12" rx="1.5" />
        <rect x="248" y="184" width="16" height="12" rx="1.5" />
      </g>
      <rect x="266" y="184" width="16" height="12" rx="1.5" fill="#a3242f" stroke="#d13a48" stroke-width="0.7" />

      <!-- bass ports -->
      <g fill="#08080a" stroke="#3a3a42" stroke-width="0.7">
        {ports.map((i) => <rect x={160 + i * 32} y={202} width="26" height="5" rx="2.5" />)}
      </g>

      <!-- knobs -->
      <g>
        <circle cx="126" cy="214" r="8" fill="url(#bbChrome)" />
        <circle cx="126" cy="214" r="5.2" fill="#1c1c20" />
        <line x1="126" y1="214" x2="126" y2="210" stroke="#92ff00" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="314" cy="214" r="8" fill="url(#bbChrome)" />
        <circle cx="314" cy="214" r="5.2" fill="#1c1c20" />
        <line x1="314" y1="214" x2="317" y2="211" stroke="#92ff00" stroke-width="1.5" stroke-linecap="round" />
      </g>

      <!-- MEGA BASS badge, centred under the console -->
      <rect x="174" y="205" width="92" height="14" rx="7" fill="#0d0d0f" stroke="url(#bbBrass)" stroke-width="1.1" />
      <text x="220" y="215" fill="url(#bbBrass)" font-family="Arial, sans-serif" font-size="8" font-weight="bold" text-anchor="middle" letter-spacing="1.5">MEGA BASS</text>

      <!-- feet -->
      <rect x="46" y="230" width="36" height="7" rx="3" fill="#121215" />
      <rect x="358" y="230" width="36" height="7" rx="3" fill="#121215" />
    </svg>
    <span class="boombox-label">▶ Play a random show</span>
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("cc-boombox");
    if (!btn) return;
    var shows = [];
    try {
      shows = JSON.parse(btn.getAttribute("data-shows") || "[]");
    } catch (e) {}
    var last = -1;

    function playRandom() {
      if (!shows.length || typeof window.ccPlay !== "function") return;
      var i = Math.floor(Math.random() * shows.length);
      // Avoid repeating the same show twice in a row.
      if (shows.length > 1 && i === last) i = (i + 1) % shows.length;
      last = i;
      window.ccPlay(shows[i].k, shows[i].t);
    }

    btn.addEventListener("click", playRandom);

    // The sticky player calls this when a mix ends, so the deck keeps rolling
    // through the archive rather than stopping after one show.
    window.ccNextRandom = playRandom;

    // No autoplay: nothing plays until the visitor asks for it.
  })();
</script>
