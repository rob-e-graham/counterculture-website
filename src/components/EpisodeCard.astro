---
import type { Episode } from "../data/episodes";
import EpisodeArt from "./EpisodeArt.astro";

type Props = {
  episode: Episode;
  index?: number;
};

const { episode, index = 0 } = Astro.props;
const duration = episode.audioLength
  ? `${Math.round(episode.audioLength / 60)} min`
  : "Replay";
const dateLabel = new Date(`${episode.date}T12:00:00`).toLocaleDateString(
  "en-AU",
  { day: "numeric", month: "short", year: "numeric" }
);
---

<article class="episode-card">
  <button
    class="episode-cover"
    type="button"
    data-cc-play={episode.mixcloudKey}
    data-cc-title={episode.title}
    aria-label={`Play ${episode.title}`}
  >
    <EpisodeArt slug={episode.slug} date={episode.date} dj={episode.dj} index={index} />
    <span class="episode-play" aria-hidden="true">▶</span>
  </button>
  <div>
    <h3><a href={`/episodes/${episode.slug}`}>{episode.title}</a></h3>
    <p class="episode-meta-line">{dateLabel} · {duration}</p>
    <div class="link-row">
      <button
        class="text-link"
        type="button"
        data-cc-play={episode.mixcloudKey}
        data-cc-title={episode.title}
      >
        ▶ Play
      </button>
      <a class="text-link" href={`/episodes/${episode.slug}`}>Details</a>
    </div>
  </div>
</article>
