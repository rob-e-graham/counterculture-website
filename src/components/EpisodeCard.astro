---
import type { Episode } from "../data/episodes";

type Props = {
  episode: Episode;
};

const { episode } = Astro.props;
const duration = episode.audioLength
  ? `${Math.round(episode.audioLength / 60)} min`
  : "Replay";
---

<article class="episode-card">
  <img src={episode.artwork} alt="" loading="lazy" />
  <div>
    <p class="eyebrow">{new Date(`${episode.date}T12:00:00`).toLocaleDateString("en-AU")}</p>
    <h3><a href={`/episodes/${episode.slug}`}>{episode.title}</a></h3>
    <p>{duration}</p>
    <div class="link-row">
      <a class="text-link" href={`/episodes/${episode.slug}`}>Play</a>
      <a class="text-link" href={episode.mixcloudUrl}>Mixcloud</a>
    </div>
  </div>
</article>
